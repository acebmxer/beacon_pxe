{
  "distros": [
    {
      "id": "debian",
      "name": "Debian",
      "default_mirror": "https://deb.debian.org/debian",
      "archive_url": "{mirror}/dists/{version}/main/installer-amd64/current/images/netboot/netboot.tar.gz",
      "kernel_member": "debian-installer/amd64/linux",
      "initrd_member": "debian-installer/amd64/initrd.gz",
      "version_member": "version.info",
      "version_regex": "Debian version:\\s+\\S+\\s+\\((\\w+)\\)",
      "boot_args": "mirror/country=manual mirror/protocol={mirror_proto} mirror/{mirror_proto}/hostname={mirror_host} mirror/{mirror_proto}/directory={mirror_path}",
      "eol_dates_url": "https://debian.pages.debian.net/distro-info-data/debian.csv",
      "releases": [
        {
          "id": "forky",
          "label": "Debian 14 (forky, testing \u2014 pre-release)",
          "number": "14"
        },
        {
          "id": "trixie",
          "label": "Debian 13 (trixie)",
          "default": true,
          "number": "13",
          "eol": "2030-06-30"
        },
        {
          "id": "bookworm",
          "label": "Debian 12 (bookworm)",
          "number": "12",
          "eol": "2028-06-30"
        },
        {
          "id": "bullseye",
          "label": "Debian 11 (bullseye)",
          "number": "11",
          "eol": "2026-08-31"
        }
      ],
      "number_lookup": {
        "release_url": "{mirror}/dists/{suite}/Release",
        "suites": [
          "stable",
          "oldstable",
          "oldoldstable"
        ],
        "testing": "testing"
      },
      "live": {
        "iso_regex": "debian-live-(?:[0-9.]+|testing)-amd64-{flavour}\\.iso",
        "releases": [
          {
            "id": "forky",
            "name": "Debian 14",
            "label": "Debian 14 (forky, testing \u2014 pre-release)",
            "base_url": "https://cdimage.debian.org/cdimage/weekly-live-builds/amd64/iso-hybrid",
            "number": "14"
          },
          {
            "id": "trixie",
            "name": "Debian 13",
            "label": "Debian 13 (trixie)",
            "base_url": "https://cdimage.debian.org/debian-cd/current-live/amd64/iso-hybrid",
            "default": true,
            "number": "13",
            "eol": "2030-06-30"
          },
          {
            "id": "bookworm",
            "name": "Debian 12",
            "label": "Debian 12 (bookworm)",
            "base_url": "https://cdimage.debian.org/cdimage/archive",
            "dir_regex": "12\\.[0-9.]+-live/",
            "subpath": "amd64/iso-hybrid",
            "number": "12",
            "eol": "2028-06-30"
          },
          {
            "id": "bullseye",
            "name": "Debian 11",
            "label": "Debian 11 (bullseye)",
            "base_url": "https://cdimage.debian.org/cdimage/archive",
            "dir_regex": "11\\.[0-9.]+-live/",
            "subpath": "amd64/iso-hybrid",
            "number": "11",
            "eol": "2026-08-31"
          }
        ],
        "unlisted_folders": [
          {
            "base_url": "https://cdimage.debian.org/debian-cd/current-live/amd64/iso-hybrid"
          },
          {
            "base_url": "https://cdimage.debian.org/cdimage/archive",
            "dir_regex": "{number}\\.[0-9.]+-live/",
            "subpath": "amd64/iso-hybrid"
          }
        ],
        "kernel_member": "live/vmlinuz",
        "initrd_member": "live/initrd.img",
        "root_member": "live/filesystem.squashfs",
        "boot_args": "boot=live fetch=${{boot-url}}/os/{image_id}/filesystem.squashfs ip=dhcp",
        "flavours": [
          {
            "id": "kde",
            "label": "KDE Plasma"
          },
          {
            "id": "gnome",
            "label": "GNOME"
          },
          {
            "id": "xfce",
            "label": "Xfce"
          },
          {
            "id": "cinnamon",
            "label": "Cinnamon"
          },
          {
            "id": "mate",
            "label": "MATE"
          },
          {
            "id": "lxqt",
            "label": "LXQt"
          },
          {
            "id": "lxde",
            "label": "LXDE"
          },
          {
            "id": "standard",
            "label": "Standard (no desktop)"
          }
        ],
        "testing_folder": "https://cdimage.debian.org/cdimage/weekly-live-builds/amd64/iso-hybrid"
      }
    }
  ]
}
